@model CategoriesPageVm
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="text-decoration-none">&larr; Back to events</a>
<h1 class="h3 mt-2">Categories</h1>
<p class="text-muted">@Model.Event.EventName &middot; @Model.Event.EventDate.ToString("dd MMM yyyy") &middot; @Model.Event.Location</p>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">This event has no categories yet. Add one below so participants can enter.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Distance</th>
                    <th>Max participants</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td>@c.CategoryName</td>
                        <td>@c.DistanceKm km</td>
                        <td>@c.MaxParticipants</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="EditCategory"
                               asp-route-eventId="@Model.Event.EventId" asp-route-id="@c.CategoryId">Edit</a>
                            <form asp-action="DeleteCategory" asp-route-eventId="@Model.Event.EventId"
                                  asp-route-id="@c.CategoryId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this category?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="card mt-4">
    <div class="card-body">
        <h2 class="h5">Add a category</h2>
        <form asp-action="CreateCategory" method="post" class="row g-3">
            <input type="hidden" name="EventId" value="@Model.Event.EventId" />
            <div class="col-md-5">
                <label class="form-label" for="CategoryName">Category name</label>
                <input class="form-control" id="CategoryName" name="CategoryName" placeholder="e.g. 10km Fun Run" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="DistanceKm">Distance (km)</label>
                <input class="form-control" id="DistanceKm" name="DistanceKm" type="number" step="0.1" min="0.1" required />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="MaxParticipants">Max participants</label>
                <input class="form-control" id="MaxParticipants" name="MaxParticipants" type="number" min="1" value="100" required />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100">Add</button>
            </div>
        </form>
    </div>
</div>