@model List<EventDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My Events</h1>
    <a class="btn btn-success" asp-action="CreateEvent">+ New event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">You have not created any events yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model.OrderBy(e => e.EventDate))
                {
                    <tr>
                        <td>@ev.EventName</td>
                        <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td>@ev.Distance km</td>
                        <td>@ev.EventType</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-eventId="@ev.EventId">Categories</a>
                            <a class="btn btn-sm btn-outline-dark" asp-action="EditEvent" asp-route-id="@ev.EventId">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}