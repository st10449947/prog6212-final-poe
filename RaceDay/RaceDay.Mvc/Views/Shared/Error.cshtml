@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center mt-5">
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">Sorry, RaceDay ran into a problem with that request. Please try again.</p>
    <a class="btn btn-success" asp-controller="Home" asp-action="Index">Back to home</a>

    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>